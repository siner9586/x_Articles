<div class="wechat-wrap" data-wechat-popover>
  <button class="wechat-trigger" type="button" aria-expanded="false" aria-controls="wechat-popover-panel">公众号</button>
  <div class="wechat-popover" id="wechat-popover-panel" hidden>
    <img src="/assets/wechat-qrcode.svg" width="206" height="206" alt="公众号二维码" loading="lazy" />
    <p>扫码关注：灵感与观点交流</p>
  </div>
</div>
<script>
  const root = document.querySelector('[data-wechat-popover]');
  const button = root?.querySelector('.wechat-trigger');
  const panel = root?.querySelector('.wechat-popover');
  function closePanel() {
    if (!button || !panel) return;
    panel.setAttribute('hidden', '');
    button.setAttribute('aria-expanded', 'false');
  }
  button?.addEventListener('click', (event) => {
    event.stopPropagation();
    if (!panel || !button) return;
    const isHidden = panel.hasAttribute('hidden');
    if (isHidden) {
      panel.removeAttribute('hidden');
      button.setAttribute('aria-expanded', 'true');
    } else {
      closePanel();
    }
  });
  document.addEventListener('click', (event) => {
    if (root && !root.contains(event.target)) closePanel();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePanel();
  });
</script>
