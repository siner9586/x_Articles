---
import { topicName } from '../lib/topics';
const { article, rank = 1 } = Astro.props;
---
<article class="article-card">
  <div class="card-head">
    <div class="rank">#{rank}</div>
    <div class="article-main">
      <h3 class="article-title">{article.title}</h3>
      <div class="meta">
        <span>@{article.author_username} / {article.author_name}</span>
        <span>{new Date(article.created_at).toLocaleDateString('zh-CN')}</span>
        <span>{topicName(article.topic_id)}</span>
      </div>
      <p class="summary"><strong>为什么值得看：</strong>{article.summary.why_it_matters}</p>
      <div class="pills">
        <span class="pill hot">收藏 {article.metrics.bookmark_count}</span>
        <span class="pill">点赞 {article.metrics.like_count}</span>
        <span class="pill">浏览 {article.metrics.impression_count}</span>
        <span class="pill score">综合分 {article.score.article_score}</span>
        {article.summary.topic_tags.slice(0,3).map((tag) => <span class="pill">{tag}</span>)}
      </div>
      <div class="actions">
        <a class="button primary" href={article.url} target="_blank" rel="noopener noreferrer">打开原文</a>
        <a class="button" href={`/articles/${article.id}/`}>查看详情</a>
      </div>
    </div>
  </div>
</article>
