---
import { parse } from 'yaml';
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
const q = parse(fs.readFileSync('data/sources/query_templates.yaml', 'utf8'));
const topics = ['AI Agent','AI Coding','Reasoning Models','Multimodal','AI Search','AI Browser','AI Infra','Open Source','Startups','Product','Investment','Research','Robotics','Safety','中文 AI 观点'];
---
<BaseLayout title="Topics | X Articles Daily">
  <section class="hero"><div class="container"><div class="eyebrow">Topics</div><h1>Topics</h1><p class="lead">主题词驱动候选过滤、评分、聚类与静态搜索；每期不会让热度压倒质量。</p></div></section>
  <section class="section"><div class="container"><div class="source-grid">{topics.map((topic) => <div class="source-card"><strong>{topic}</strong><small>Tracked topic</small><span class="tag">article-first</span></div>)}</div></div></section>
  <section class="section"><div class="container"><div class="grid"><div class="panel"><h2>英文主题词</h2><div class="tags">{q.topics_en.map((t) => <span class="tag">{t}</span>)}</div></div><div class="panel"><h2>中文主题词</h2><div class="tags">{q.topics_zh.map((t) => <span class="tag">{t}</span>)}</div></div></div></div></section>
</BaseLayout>
