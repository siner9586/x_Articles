---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateIssueReport } from '../../lib/reports';
const firstIssue = generateIssueReport();
---
<BaseLayout title="Issues | X Articles Intelligence">
  <section class="hero">
    <div class="container hero-card">
      <span class="eyebrow">Issues</span>
      <h1>X Articles 学习精选期刊</h1>
      <p>第一期使用仓库内 mock/manual seed 数据生成，作为无 X MCP 连接器时的可运行样例。接入官方 X MCP 后，可由同一结构替换为真实按需整理结果。</p>
    </div>
  </section>
  <section class="container">
    <article class="article-card">
      <div class="card-head">
        <div class="rank">01</div>
        <div class="article-main">
          <h2 class="article-title">{firstIssue.title}</h2>
          <p class="summary">{firstIssue.summary}</p>
          <div class="pills">
            <span class="pill hot">Top 10</span>
            <span class="pill">mock/manual</span>
            <span class="pill score">官方 X MCP ready</span>
          </div>
          <div class="actions">
            <a class="button primary" href="/issues/2026-07-02/">打开第一期</a>
            <a class="button" href="/api/reports/issue">查看 JSON</a>
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
