{
  "name": "x-articles-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --compatibility-date=2026-07-02 -- npm run build",
    "dev:ui": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist --compatibility-date=2026-07-02",
    "test": "tsx scripts/test.ts",
    "db:migrate": "wrangler d1 migrations apply x_articles --local",
    "db:migrate:remote": "wrangler d1 migrations apply x_articles --remote",
    "seed": "tsx scripts/seed.ts",
    "collect": "tsx scripts/collect.ts",
    "refresh-metrics": "tsx scripts/refresh-metrics.ts",
    "reports:generate": "tsx scripts/generate-report.ts"
  },
  "dependencies": {
    "astro": "^4.16.18"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
